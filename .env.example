# Copy to `.env` for local development. Never commit `.env`.
# On the Apify platform these are set as Actor environment variables, or as a
# secret via `apify secrets add`.

# Actor-level You.com API key, used as the fallback for callers that do not
# bring their own key. Optional: without it the Actor still serves the keyless
# `?profile=free` tool set (you-search, you-discover).
# YDC_API_KEY=ydc-sk-...

# Upstream MCP server base URL. Override for staging.
# YDC_MCP_UPSTREAM_URL=https://api.you.com/mcp

# Set to "true" to enable pay-per-event charging. Requires the matching events
# to be configured for the Actor in Apify Console.
# YDC_PPE_CHARGING_ENABLED=false

# Upstream first-byte deadline in milliseconds (default 290000).
# YDC_FIRST_BYTE_TIMEOUT_MS=290000
