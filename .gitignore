storage/
.apify/
apify_storage/

# Vendored agent tooling (Apify skill). Not project source; excluded so the
# MIT license covers only our code.
.agents/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Logs
logs/
*.log
loglevel.json

# Cache directories
.cache/
.tmp/
tmp/

